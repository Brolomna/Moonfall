{
  "name": "moonfall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Moonfall — a Werewolf party game host + player app for your local Wi-Fi.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:web": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "fake": "tsx scripts/fake-players.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "views": "python3 tools/dc2tsx.py design/Host.dc.html src/views/HostView.tsx HostView && python3 tools/dc2tsx.py design/Player.dc.html src/views/PlayerView.tsx PlayerView && python3 tools/wire.py src/views/HostView.tsx src/views/PlayerView.tsx"
  },
  "dependencies": {
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
